*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries (NO ignoramos .dll para poder versionarlas)
*.so
*.dylib

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
# *.lib   # <- comentado para subir SDL2.lib, SDL2_image.lib, etc.

# Executables (no queremos subir .exe)
*.exe
*.out
*.app

########################
# Visual Studio
########################
.vs/
# *.user   <-- IMPORTANTE: comentado para que se suba el .vcxproj.user
*.suo
*.VC.db
*.VC.opendb

########################
# Builds / intermedios
########################
