bin/**

# ...PERO permitir que se suban SOLO estas DLL específicas:
!bin/
!bin/Debug/
!bin/Release/
!bin/Debug/SDL2.dll
!bin/Debug/SDL2_image.dll
!bin/Release/SDL2.dll
!bin/Release/SDL2_image.dll

# Resto de build (intermedios) ignorados
build/**/Debug/
build/**/Release/
build/**/x64/
build/**/ipch/
build/**/obj/
